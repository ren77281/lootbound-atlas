---
/**
 * LegalContent — the shared body for each legal page.
 * Renders different content based on the `page` prop. English only (per PRD).
 */
import { site } from '~/config/site';

interface Props {
  page: 'about' | 'privacy-policy' | 'terms-of-service' | 'copyright' | 'contact';
}
const { page } = Astro.props;
const game = site.game.name;
const year = new Date().getFullYear();
---

{
  page === 'about' && (
    <>
      <p>
        {site.name} is an independent fan-made guide site for {game}, a game in the{' '}
        {site.game.genre} genre on {site.game.platform} developed by {site.game.developer}. It is
        not an official wiki and is not operated by or affiliated with the developer.
      </p>
      <h2>What You Can Find Here</h2>
      <ul>
        <li>Beginner and first-run guides</li>
        <li>Explanations of inventory, item, companion, and dice mechanics</li>
        <li>Achievement and route references</li>
        <li>Versioned summaries of official updates</li>
      </ul>
      <h2>How Content Is Reviewed</h2>
      <p>
        Pages are written from official announcements, publicly visible game information, and direct
        gameplay observations. Sources are linked where practical, version-sensitive claims are
        dated, and material that cannot yet be verified remains unpublished.
      </p>
      <h2>Corrections and Questions</h2>
      {site.social.github ? (
        <p>
          To report a factual error, outdated page, or source problem, open an issue in the{' '}
          <a href={site.social.github} target="_blank" rel="noopener noreferrer">
            site issue tracker
          </a>
          . For account, purchase, or technical support for the game itself, use the{' '}
          <a href={site.social.official} target="_blank" rel="noopener noreferrer">
            official game page
          </a>
          ; those channels are not operated by this site.
        </p>
      ) : (
        <p>This site does not currently publish a direct contact channel.</p>
      )}
    </>
  )
}

{
  page === 'privacy-policy' && (
    <>
      <p>
        This privacy policy describes how {site.name} ("we", "us", or "our") handles information
        when you visit this website.
      </p>
      <h2>Information We Collect</h2>
      <p>
        {site.name} is a static website. We do not require you to create an account or submit
        personal information. We do not directly collect or store personal data.
      </p>
      <h2>Third-Party Services</h2>
      <p>
        We use third-party services that may collect information as described in their respective
        privacy policies:
      </p>
      <ul>
        <li>
          <strong>Advertising partners</strong> (e.g. Google AdSense) — may use cookies to serve
          relevant ads. You can opt out of personalized advertising via your browser settings.
        </li>
        <li>
          <strong>Analytics</strong> (e.g. Google Analytics, Cloudflare Web Analytics) — GA may
          collect anonymized usage data such as page views and approximate location (cookie-based,
          loaded only after you accept the consent banner); Cloudflare Web Analytics is cookieless
          and collects aggregate page-view data.
        </li>
        <li>
          <strong>Cloudflare</strong> — our hosting provider, which may process basic request data
          for security and performance (and serve Web Analytics when enabled, see above).
        </li>
        <li>
          <strong>Comments</strong> (giscus, opt-in) — when the comment section is enabled,
          giscus.app loads an embedded GitHub view; viewing it exposes your IP address and browser
          info to that service, and signing in to comment is handled by GitHub under its own privacy
          policy.
        </li>
        <li>
          <strong>Embedded videos</strong> (YouTube) — pages with videos load thumbnail images from
          i.ytimg.com and, after you press play, the YouTube player from youtube-nocookie.com. Until
          you interact, no YouTube cookies are set.
        </li>
      </ul>
      <h2>Cookies</h2>
      <p>
        Some third-party services set cookies. You can control cookies through your browser
        settings. Disabling cookies may affect ad personalization but will not prevent you from
        accessing site content.
      </p>
      <h2>Children's Privacy</h2>
      <p>
        {site.name} is not directed at children under 13, and we do not knowingly collect
        information from children.
      </p>
      <h2>Changes to This Policy</h2>
      <p>We may update this policy from time to time. Changes will be posted on this page.</p>
    </>
  )
}

{
  page === 'terms-of-service' && (
    <>
      <p>By accessing {site.name}, you agree to the following terms of service.</p>
      <h2>Use of Content</h2>
      <p>
        All guides, articles, and reference material on this site are provided for personal,
        non-commercial use. You may not copy, republish, or redistribute our content without
        attribution and a link back to the original page.
      </p>
      <h2>Accuracy</h2>
      <p>
        We strive for accuracy but make no warranties regarding the completeness or correctness of
        any content. {game} is frequently updated, and information may become outdated. Always
        verify critical information in-game.
      </p>
      <h2>Third-Party Links</h2>
      <p>
        This site links to external websites (official game channels, video tutorials, etc.) that we
        do not control. We are not responsible for the content or practices of third-party sites.
      </p>
      <h2>Trademarks</h2>
      <p>
        {game} and all related trademarks, logos, and assets are the property of{' '}
        {site.game.developer}. {site.name} is an independent fan project and is not affiliated with
        or endorsed by {site.game.developer}.
      </p>
      <h2>Limitation of Liability</h2>
      <p>
        Use of this site is at your own risk. We are not liable for any damages arising from your
        use of the site or reliance on its content.
      </p>
      <h2>Changes to These Terms</h2>
      <p>
        We may revise these terms at any time. Continued use of the site after changes constitutes
        acceptance of the updated terms.
      </p>
    </>
  )
}

{
  page === 'copyright' && (
    <>
      <h2>Copyright Notice</h2>
      <p>{`© ${year} ${site.name}. Unless otherwise credited, the original written guides and editorial material published on this site are protected by copyright.`}</p>
      <h2>Game Assets</h2>
      <p>
        {game} names, logos, characters, screenshots, artwork, and related assets belong to their
        respective owners, including {site.game.developer}. Their inclusion is for identification,
        commentary, and informational reference. {site.name} claims no ownership of the game's
        intellectual property.
      </p>
      <h2>Copyright Concerns</h2>
      {site.social.github ? (
        <p>
          If you believe material on this site infringes your rights, open a request in the{' '}
          <a href={site.social.github} target="_blank" rel="noopener noreferrer">
            site issue tracker
          </a>{' '}
          and include the affected page URL, the work you represent, and the requested action. Do
          not publish private identification or other sensitive information in a public issue.
        </p>
      ) : (
        <p>This site does not currently publish a dedicated copyright request channel.</p>
      )}
      <h2>Fan-Made Notice</h2>
      <p>{site.legalNotice}</p>
    </>
  )
}

{
  page === 'contact' && (
    <>
      {/* h2, not h1 — LegalPage already renders the page H1 (single-H1 rule). */}
      <h2>Contact {site.name}</h2>
      <p>
        Use the channel below for corrections, outdated information, broken links, and questions
        about content published on this site.
      </p>
      <h2>Site Feedback</h2>
      {site.social.github ? (
        <p>
          Open an issue in the{' '}
          <a href={site.social.github} target="_blank" rel="noopener noreferrer">
            public site issue tracker
          </a>
          . Include the page URL, the correction you suggest, and a reliable source when available.
          Do not include account details or other private information.
        </p>
      ) : (
        <p>This site does not currently publish a direct feedback channel.</p>
      )}
      <h2>Official Game Support</h2>
      <p>
        This site cannot help with purchases, accounts, bugs, or other official support requests.
        Visit the{' '}
        <a href={site.social.official} target="_blank" rel="noopener noreferrer">
          official {game} page
        </a>{' '}
        for developer-operated channels.
      </p>
      <h2>Copyright Requests</h2>
      <p>
        For copyright concerns and the information to include, read the{' '}
        <a href="/copyright">Copyright page</a>.
      </p>
    </>
  )
}
